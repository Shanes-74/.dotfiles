#!/usr/bin/env bash

# Cada opção já nasce em Pango markup, com o ícone grande em cima
# e o rótulo pequeno embaixo, unidos por uma quebra de linha real.
entry() {
    printf "<span font='GeistMono Nerd Font Propo' size='xx-large'>%s</span>\n<span size='xx-small'><i>%s</i></span>" "$1" "$2"
}

lock=$(entry "" "Bloquear")
logout=$(entry "󰈆" "Encerrar")
reboot=$(entry "" "Reiniciar")
shutdown=$(entry "" "Desligar")
suspend=$(entry "" "Suspender")
hibernate=$(entry "" "Hibernar")

# Como cada entrada agora tem \n de verdade dentro dela, não dá mais
# pra separar as OPÇÕES por \n. Usamos um separador improvável (RS).
SEP=$'\x1e'

rofi_cmd() {
    rofi -dmenu \
         -sep "$SEP" \
         -markup-rows \
         -p "Power Menu" \
         -theme "$HOME/.config/rofi/menus/themes/power.rasi"
}

run_rofi() {
    printf '%s' "${lock}${SEP}${logout}${SEP}${reboot}${SEP}${shutdown}${SEP}${suspend}${SEP}${hibernate}" | rofi_cmd
}

chosen="$(run_rofi)"
[[ -z "$chosen" ]] && exit 0

case "$chosen" in
    *Bloquear*)  sleep 0.5 && hyprlock ;;
    *Encerrar*)  sleep 0.5 && hyprctl dispatch 'hl.dsp.exit()' ;;
    *Reiniciar*) sleep 0.5 && systemctl reboot ;;
    *Desligar*)  sleep 0.5 && systemctl poweroff ;;
    *Suspender*) sleep 0.5 && systemctl suspend ;;
    *Hibernar*)  sleep 0.5 && systemctl hibernate ;;
esac