* {
    primary: #5bdbbe;
    on-primary: #00382d;
    primary-container: #005143;
    on-primary-container: #7af8da;
    primary-fixed: #7af8da;
    primary-fixed-dim: #5bdbbe;
    on-primary-fixed: #00201a;
    on-primary-fixed-variant: #005143;

    secondary: #85d6c0;
    on-secondary: #00382d;
    secondary-container: #005143;
    on-secondary-container: #a1f2dc;
    secondary-fixed: #a1f2dc;
    secondary-fixed-dim: #85d6c0;
    on-secondary-fixed: #00201a;
    on-secondary-fixed-variant: #005143;

    tertiary: #8bd0ef;
    on-tertiary: #003546;
    tertiary-container: #004d64;
    on-tertiary-container: #bde9ff;
    tertiary-fixed: #bde9ff;
    tertiary-fixed-dim: #8bd0ef;
    on-tertiary-fixed: #001f2a;
    on-tertiary-fixed-variant: #004d64;

    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;

    surface: #0a151aB3;
    on-surface: #d9e4eb;
    on-surface-variant: #b4cad6;
    surface-dim: #0a151a;
    surface-bright: #303b40;
    surface-container-lowest: #061014;
    surface-container-low: #131d22;
    surface-container: #172126;
    surface-container-high: #212b31B3;
    surface-container-highest: #2c363c;

    outline: #7f949f;
    outline-variant: #354a53;

    shadow: #000000;
    scrim: #000000;

    inverse-surface: #d9e4eb;
    inverse-on-surface: #273237;
    inverse-primary: #006b59;
