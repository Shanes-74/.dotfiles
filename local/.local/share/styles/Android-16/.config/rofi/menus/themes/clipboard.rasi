/**
 * Authors: Shane. (github: @shanes-74)
 * 
 * HIERARQUIA DE PROPRIEDADES (ordem de declaração)
 * =================================================
 * 1. Visibilidade / Estado: enabled, visible
 * 2. Dimensões e posicionamento: width, height, margin, padding, expand, location, anchor, x-offset, y-offset
 * 3. Layout interno: orientation, spacing, children, columns, lines, dynamic, scrollbar, scrollbar-width, layout
 * 4. Borda e arredondamento: border, border-color, border-radius
 * 5. Fundo e cores: background-color, color, text-color, placeholder-color, handle-color, handle-width
 * 6. Tipografia e conteúdo: font, placeholder, str, markup, blink
 * 7. Alinhamento: vertical-align, horizontal-align
 * 8. Cursor e interação: cursor
 * 9. Específicos do widget: size, round, etc.
 */

@import "shared/colors.rasi"

/*****----- CONFIGURATION -----*****/
configuration {
    disable-history:             false;
    show-icons:                  true;
}

/*****----- WINDOW -----*****/
window {
    location:                    south;
    anchor:                      south;
    fullscreen:                  false;
    width:                       650px;
    height:                      68%;
    y-offset:                    20px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    cursor:                      "default";
    background-color:            transparent;
    transparency:                "real";
}

/*****----- MAINBOX -----*****/
mainbox {
    spacing:                     15px;
    padding:                     15px 15px 30px 15px;
    border:                      1px;
    border-color:                @outline-variant;
    border-radius:               20px 20px 0 0;
    background-color:            @surface;
    color:                       @on-surface;
    children:                    [ "inputbar", "message", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    spacing:                     10px;
    children:                    [ "textbox-0", "entry" ];
    background-color:            inherit;
}

/*****----- TEXTBOX-0 -----*****/
textbox-0 {
    enabled:                     true;
    expand:                      false;
    width:                       3%;
    height:                      50%;
    border-radius:               99px;
    color:                       @surface;
    background-color:            @tertiary;
    font:                        "GeistMono Nerd Font Propo, bold 18";
    str:                         "";
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

prompt {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @primary;
}

textbox-prompt-colon {
    enabled:                    false;  /* removido — o prompt já tem ícone */
}

/*****----- ENTRY -----*****/
entry {
    padding:                     15px 15px;
    border:                      1px;
    border-color:                @outline-variant;
    border-radius:               99px;
    background-color:            @surface-container-high;
    color:                       @on-surface;
    placeholder-color:           @outline;
    placeholder:                 "Buscar no histórico...";
    vertical-align:              0.5;
}

/*****----- Listview -----*****/
listview {
    columns:                    1;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               false;
    fixed-columns:              true;
    spacing:                    4px;
    margin:                     0px;
    padding:                    10px;
    border:                      1px;
    border-color:                @outline-variant;
    border-radius:               20px;
    background-color:            @surface-container-high;
    color:                       @on-surface;
}

/*****----- ELEMENT -----*****/
element {
    enabled:                     true;
    margin:                      6px 6px -4px 6px;
    padding:                     5px 10px;
    border-radius:               20px;
    background-color:            transparent;
    color:                       @on-surface;
    cursor:                      pointer;
}

/*****----- SCROLLBAR -----*****/
#scrollbar {
    border-radius:               20px;
    background-color:            inherit;
    handle-color:                @tertiary;
    handle-width:                10px;
}

/*****----- ELEMENT -----*****/
element {
    enabled:                     true;
    margin:                      6px 6px -4px 6px;
    padding:                     5px 10px;
    border-radius:               20px;
    background-color:            transparent;
    color:                       @on-surface;
    cursor:                      pointer;
}

/*****----- ELEMENT SELECTED -----*****/
element selected.normal {
    background-color:            @primary;
    color:                       @surface;
}

/*****----- ELEMENT ICON -----*****/
element-icon {
    size:                        56px;
    margin:                      0 5px 0 -5px;
    border-radius:               20px;
    background-color:            @surface-container;
    color:                       inherit;
    cursor:                      pointer;
}

/*****----- ELEMENT ICON SELECTED -----*****/
element-icon selected.normal {

}

/*****----- ELEMENT TEXT -----*****/
element-text {
    background-color:            transparent;
    color:                       inherit;
    vertical-align:              0.5;
    cursor:                      inherit;
}

/*****----- MESSAGE -----*****/
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      1px;
    border-color:                @outline-variant;
    border-radius:               20px;
    background-color:            @surface-container-high;
    color:                       @surface;
}

/*****----- TEXTBOX -----*****/
textbox {
    padding:                     10px;
    border-radius:               20px;
    background-color:            inherit;
    color:                       @on-surface;
    placeholder-color:           @on-surface-variant;
    blink:                       true;
    markup:                      true;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

/*****----- ERROR MESSAGE -----*****/
error-message {
    padding:                     10px;
    border-radius:               20px 20px 0 0;
    background-color:            @error-container;
}
