@import "shared/colors.rasi"

/*****----- Configuration -----*****/
configuration {
    show-icons: false;
    font: "Google Sans Display Medium 25";
    hover-select: true;
}

/*****----- Main Window -----*****/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      600px;
    background-color:           transparent;
}

mainbox {
    spacing:                     15px;
    padding:                     15px;
    border:                      1px;
    border-color:                @outline-variant;
    border-radius:               35px;
    background-color:            @surface;
    children:                    [ "listview" ];
}

/*****----- Listview -----*****/
listview {
    columns:                    3;
    lines:                      2;
    spacing:                    16px;
    cycle:                      true;
    dynamic:                    true;
    layout:                     vertical;
    fixed-columns:              true;
    background-color:           transparent;
}

/*****----- Elements -----*****/
element {
    orientation:                vertical;
    border:                     2px;
    border-color:               @outline-variant;
    border-radius:              999px;
    background-color:           @surface-container-high;
    cursor:                     pointer;
}

element-text {
    padding:                    67px 0px;
    background-color:           transparent;
    text-color:                 inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
}

/****----- Estados de Selção -----****/
element normal {
    text-color:                 @on-surface;
}

element selected normal {
    background-color:           @primary;
    text-color:                 @on-primary;
    border-radius:              50px;
}
