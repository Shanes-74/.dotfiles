@import "shared/colors.rasi"

/*****----- Configuration -----*****/
configuration {
    show-icons:                 true;
}

/*****----- Main Window -----*****/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      75%;
    x-offset:                   0px;
    y-offset:                   0px;

    margin:                     0px;
    padding:                    0px;
    cursor:                     "default";
    background-color:           transparent;
}

/*****----- Main Box -----*****/
mainbox {
    padding:                    15px;
    border:                     1px;
    border-radius:              35px;
    border-color:               @outline-variant;
    background-color:           @surface;
    children:                   [ "listview" ];
}

/*****----- Listview -----*****/
listview {
    spacing:                    10px;
    columns:                    5;
    lines:                      1;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    fixed-columns:              true;

    margin:                     0px;
    padding:                    15px;
    border:                     1px;
    border-radius:              20px;
    border-color:               @outline-variant;
    background-color:           @surface-container-high;
}

/*****----- Elements -----*****/
element {
    orientation:                vertical;
    padding:                    8px;
    border-radius:              28px;
    background-color:           transparent;
}

element-icon {
    size:                       400px;
    border-radius:              20px;
    background-color:           transparent;
}

element-text {
    enabled:                    false;
}

/****----- Estados de Seleção -----****/

element selected {
    background-color:           @primary;
}

/*****----- Message -----*****/

message {
    padding:                    10px;
    background-color:           @surface-container-low;
    border-radius:              12px;
}
