// -*- mode: jsonc -*-

////////////////////////////////////////////////
// CONFIGURAÇÃO PRINCIPAL – DUAS BARRAS
//   - Monitor principal (eDP-1): todos os módulos
//   - Monitor HDMI (HDMI-A-2): apenas o centro
////////////////////////////////////////////////

[
  // ============================================================================
  // BARRA DO MONITOR PRINCIPAL (eDP-1)
  // ============================================================================
  {
    "output": "eDP-1",
    "include": "modules/modules.jsonc",

    "modules-left": [
      "group/left"
    ],

    "modules-center": [
      "group/center"
    ],

    "modules-right": [
      "group/right"
    ]
  },

  // ============================================================================
  // BARRA DO SEGUNDO MONITOR (HDMI-A-2) – APENAS O CENTRO
  // ============================================================================
  {
    "output": "HDMI-A-2",
    "include": "modules/modules.jsonc",

    "modules-left": [],

    "modules-center": [
      "group/center"
    ],

    "modules-right": []
  }
]