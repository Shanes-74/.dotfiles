{
  "name": "Matugen",
  "type": "dark",
  "colors": {
    "editor.background": "{{ colors.background.default.hex }}",
    "editor.foreground": "{{ colors.on_background.default.hex }}",
    "editorLineNumber.foreground": "{{ colors.outline.default.hex }}",
    "editorLineNumber.activeForeground": "{{ colors.on_surface.default.hex }}",
    "editorCursor.foreground": "{{ colors.primary.default.hex }}",
    "editor.selectionBackground": "{{ colors.primary_container.default.hex }}",
    "editor.selectionHighlightBackground": "{{ colors.secondary_container.default.hex }}",
    "editor.wordHighlightBackground": "{{ colors.secondary_container.default.hex }}",
    "editor.findMatchBackground": "{{ colors.tertiary_container.default.hex }}",
    "editor.findMatchHighlightBackground": "{{ colors.tertiary_container.default.hex_alpha | set_alpha: 0.5 }}",
    "editor.lineHighlightBackground": "{{ colors.surface_variant.default.hex_alpha | set_alpha: 0.3 }}",
    "editorIndentGuide.background1": "{{ colors.outline_variant.default.hex }}",
    "editorIndentGuide.activeBackground1": "{{ colors.outline.default.hex }}",
    "editorWhitespace.foreground": "{{ colors.outline_variant.default.hex }}",
    "editorBracketMatch.background": "{{ colors.secondary_container.default.hex }}",
    "editorBracketMatch.border": "{{ colors.secondary.default.hex }}",

    "editorWidget.background": "{{ colors.surface_container.default.hex }}",
    "editorWidget.border": "{{ colors.outline_variant.default.hex }}",
    "editorSuggestWidget.background": "{{ colors.surface_container.default.hex }}",
    "editorSuggestWidget.selectedBackground": "{{ colors.secondary_container.default.hex }}",
    "editorHoverWidget.background": "{{ colors.surface_container.default.hex }}",
    "editorHoverWidget.border": "{{ colors.outline_variant.default.hex }}",

    "activityBar.background": "{{ colors.surface.default.hex }}",
    "activityBar.foreground": "{{ colors.on_surface.default.hex }}",
    "activityBar.inactiveForeground": "{{ colors.on_surface_variant.default.hex }}",
    "activityBar.activeBorder": "{{ colors.primary.default.hex }}",
    "activityBarBadge.background": "{{ colors.primary.default.hex }}",
    "activityBarBadge.foreground": "{{ colors.on_primary.default.hex }}",

    "sideBar.background": "{{ colors.surface.default.hex }}",
    "sideBar.foreground": "{{ colors.on_surface_variant.default.hex }}",
    "sideBarTitle.foreground": "{{ colors.on_surface.default.hex }}",
    "sideBarSectionHeader.background": "{{ colors.surface_container.default.hex }}",
    "list.activeSelectionBackground": "{{ colors.secondary_container.default.hex }}",
    "list.activeSelectionForeground": "{{ colors.on_secondary_container.default.hex }}",
    "list.inactiveSelectionBackground": "{{ colors.surface_variant.default.hex_alpha | set_alpha: 0.4 }}",
    "list.hoverBackground": "{{ colors.surface_variant.default.hex_alpha | set_alpha: 0.25 }}",
    "list.focusBackground": "{{ colors.secondary_container.default.hex }}",

    "titleBar.activeBackground": "{{ colors.surface.default.hex }}",
    "titleBar.activeForeground": "{{ colors.on_surface.default.hex }}",
    "titleBar.inactiveBackground": "{{ colors.surface.default.hex }}",
    "titleBar.inactiveForeground": "{{ colors.on_surface_variant.default.hex }}",

    "statusBar.background": "{{ colors.surface.default.hex }}",
    "statusBar.foreground": "{{ colors.on_surface_variant.default.hex }}",
    "statusBar.debuggingBackground": "{{ colors.tertiary_container.default.hex }}",
    "statusBar.debuggingForeground": "{{ colors.on_tertiary_container.default.hex }}",
    "statusBar.noFolderBackground": "{{ colors.surface.default.hex }}",
    "statusBarItem.remoteBackground": "{{ colors.primary_container.default.hex }}",
    "statusBarItem.remoteForeground": "{{ colors.on_primary_container.default.hex }}",

    "tab.activeBackground": "{{ colors.background.default.hex }}",
    "tab.activeForeground": "{{ colors.on_background.default.hex }}",
    "tab.activeBorderTop": "{{ colors.primary.default.hex }}",
    "tab.inactiveBackground": "{{ colors.surface.default.hex }}",
    "tab.inactiveForeground": "{{ colors.on_surface_variant.default.hex }}",
    "tab.border": "{{ colors.outline_variant.default.hex }}",
    "editorGroupHeader.tabsBackground": "{{ colors.surface.default.hex }}",

    "panel.background": "{{ colors.surface.default.hex }}",
    "panel.border": "{{ colors.outline_variant.default.hex }}",
    "panelTitle.activeBorder": "{{ colors.primary.default.hex }}",
    "panelTitle.activeForeground": "{{ colors.on_surface.default.hex }}",

    "terminal.background": "{{ colors.background.default.hex }}",
    "terminal.foreground": "{{ colors.on_background.default.hex }}",
    "terminalCursor.foreground": "{{ colors.primary.default.hex }}",
    "terminal.ansiBlack": "{{ colors.surface.default.hex }}",
    "terminal.ansiRed": "{{ colors.error.default.hex }}",
    "terminal.ansiGreen": "{{ colors.secondary.default.hex | saturate: 20.0, hsl }}",
    "terminal.ansiYellow": "{{ colors.tertiary.default.hex | saturate: 15.0, hsl }}",
    "terminal.ansiBlue": "{{ colors.primary.default.hex }}",
    "terminal.ansiMagenta": "{{ colors.tertiary.default.hex }}",
    "terminal.ansiCyan": "{{ colors.secondary_container.default.hex | saturate: 20.0, hsl }}",
    "terminal.ansiWhite": "{{ colors.on_surface_variant.default.hex }}",
    "terminal.ansiBrightBlack": "{{ colors.surface_variant.default.hex }}",
    "terminal.ansiBrightRed": "{{ colors.error.default.hex | auto_lightness: 10.0 }}",
    "terminal.ansiBrightGreen": "{{ colors.secondary.default.hex | auto_lightness: 10.0 | saturate: 20.0, hsl }}",
    "terminal.ansiBrightYellow": "{{ colors.tertiary.default.hex | auto_lightness: 10.0 | saturate: 15.0, hsl }}",
    "terminal.ansiBrightBlue": "{{ colors.primary.default.hex | auto_lightness: 10.0 }}",
    "terminal.ansiBrightMagenta": "{{ colors.tertiary.default.hex | auto_lightness: 10.0 }}",
    "terminal.ansiBrightCyan": "{{ colors.primary_container.default.hex | saturate: 10.0, hsl }}",
    "terminal.ansiBrightWhite": "{{ colors.on_background.default.hex }}",

    "button.background": "{{ colors.primary.default.hex }}",
    "button.foreground": "{{ colors.on_primary.default.hex }}",
    "button.hoverBackground": "{{ colors.primary.default.hex | auto_lightness: -5.0 }}",
    "focusBorder": "{{ colors.primary.default.hex }}",
    "progressBar.background": "{{ colors.primary.default.hex }}",
    "badge.background": "{{ colors.primary_container.default.hex }}",
    "badge.foreground": "{{ colors.on_primary_container.default.hex }}",

    "input.background": "{{ colors.surface_container.default.hex }}",
    "input.foreground": "{{ colors.on_surface.default.hex }}",
    "input.border": "{{ colors.outline_variant.default.hex }}",
    "dropdown.background": "{{ colors.surface_container.default.hex }}",
    "dropdown.foreground": "{{ colors.on_surface.default.hex }}",

    "scrollbarSlider.background": "{{ colors.outline_variant.default.hex_alpha | set_alpha: 0.4 }}",
    "scrollbarSlider.hoverBackground": "{{ colors.outline.default.hex_alpha | set_alpha: 0.5 }}",
    "scrollbarSlider.activeBackground": "{{ colors.primary.default.hex_alpha | set_alpha: 0.5 }}"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "{{ colors.primary.default.hex }}" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "{{ colors.secondary.default.hex | saturate: 20.0, hsl }}" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "{{ colors.tertiary.default.hex | saturate: 15.0, hsl }}" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "{{ colors.primary.default.hex | auto_lightness: 10.0 }}" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "{{ colors.tertiary.default.hex | auto_lightness: 10.0 }}" }
    },
    {
      "scope": ["variable", "variable.parameter"],
      "settings": { "foreground": "{{ colors.on_surface.default.hex }}" }
    },
    {
      "scope": ["variable.other.constant"],
      "settings": { "foreground": "{{ colors.tertiary.default.hex }}" }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.tag"],
      "settings": { "foreground": "{{ colors.secondary_container.default.hex | saturate: 20.0, hsl }}" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{ colors.error.default.hex }}" }
    }
  ]
}